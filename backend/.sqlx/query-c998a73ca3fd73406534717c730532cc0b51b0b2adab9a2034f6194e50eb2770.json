{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.id, c.user_id, u.handle, c.species_key, c.caught_at, c.lat, c.lng, c.media_id\n        FROM catches c\n        JOIN users u ON u.id = c.user_id\n        WHERE c.user_id = $1\n        ORDER BY c.caught_at DESC\n        LIMIT 500\n        ",

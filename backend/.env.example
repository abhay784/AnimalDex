# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://animaldex:animaldex_dev@localhost:5434/animaldex
REDIS_URL=redis://localhost:6380

# Generate a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-before-anything-real

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=catch-photos
S3_ACCESS_KEY=animaldex
S3_SECRET_KEY=animaldex_dev_secret

CORE_API_ADDR=0.0.0.0:8080
MEDIA_SVC_ADDR=0.0.0.0:8081
RUST_LOG=info,sqlx=warn,tower_http=debug
